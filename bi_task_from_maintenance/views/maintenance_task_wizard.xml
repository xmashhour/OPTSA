<odoo>
  <data>

    <!-- task wizard -->
      <record id="maintenance_task_wizard" model="ir.ui.view">
            <field name="name">maintenance.task.form</field>
            <field name="model">maintenance.task</field>
            <field name="arch" type="xml">
                <form string="Maintenance">
                    <div class="oe_title">
                        <label for="title" string="Task"/>
                        <h1>
                            <field name="title" placeholder="Task Title..."/>
                        </h1>
                    </div>

                    <group>
                    <group>
                        <field name="project_id"/>
                        <field name="user_ids" widget="many2many_tags"/>

                    </group>
                    <group>
                        <field name="planned_hours"/>
                        <field name="date_deadline"/>
                        <field name="tag_ids" widget="many2many_tags" />
                        
                    </group>
                   </group>
                    <group>
                        <field name="description" placeholder="Internal Notes"/>
                    </group>

                    <footer>
                        <button name="create_task" string="Create Task" 
                          type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-default" special="cancel" />
                   </footer>
                </form>
            </field>
        </record>

        <record id="maintenance_task_action" model="ir.actions.act_window">
             <field name="name">Create Task</field>
             <field name="type">ir.actions.act_window</field>
             <field name="res_model">maintenance.task</field>
             <field name="view_mode">form</field>
             <field name="target">new</field>
        </record>

    </data>
</odoo>
